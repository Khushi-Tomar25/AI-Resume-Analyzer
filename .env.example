# ========================================================
# AI-Powered Resume Analyzer - Environment Configuration
# ========================================================

# Anthropic Claude API Key (Required for live AI insights & bullet point rewriting)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Supported Claude Models:
# - claude-3-5-sonnet-20241022 (Recommended for deep reasoning & critiques)
# - claude-3-5-haiku-20241022 (Fast & cost-effective)
# - claude-3-haiku-20240307
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Application Settings
APP_ENV=development
MAX_FILE_SIZE_MB=10
DEBUG=False
